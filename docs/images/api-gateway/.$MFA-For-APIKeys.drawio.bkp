        <mxCell id="fvv0S7Gdkh-mr2_CQ6a0-33" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;C&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" parent="Qk9Qh86WJIAYJ9Z8XEue-1" vertex="1">
