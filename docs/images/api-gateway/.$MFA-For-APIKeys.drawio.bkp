        </mxCell>
        <mxCell id="8ZJvOG1FZV36GMm8jSOF-4" value="&lt;h1&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Validates&lt;/span&gt;&lt;/h1&gt;&lt;h1&gt;&lt;span style=&quot;background-color: initial; font-size: 12px; font-weight: normal;&quot;&gt;The Load Balancer is set to require a valid, trusted client certificate and to reject all other requests&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="81" y="240" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="8ZJvOG1FZV36GMm8jSOF-5" value="&lt;h1&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Valid Request&lt;/span&gt;&lt;/h1&gt;&lt;h1&gt;&lt;span style=&quot;background-color: initial; font-size: 12px; font-weight: normal;&quot;&gt;The Load Balancer adds the header client_cert_sha256_fingerprint with the fingerprint from the certificate so this can be used downstream by the API Gateway&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="520" y="230" width="270" height="170" as="geometry" />
        </mxCell>
